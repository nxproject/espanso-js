{
  "name": "espanso-js",
  "version": "0.2.1",
  "description": "A JavaScript port of the espanso text expander that runs in the browser",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "main": "./src/index.js",
  "module": "./src/index.js",
  "browser": "./dist/espanso.esm.js",
  "exports": {
    ".": {
      "browser": "./dist/espanso.esm.js",
      "default": "./src/index.js"
    },
    "./core": "./src/core.js"
  },
  "files": [
    "src",
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "test": "node --test \"test/**/*.test.js\"",
    "demo": "npm run build && node scripts/serve.js",
    "test:browser": "node --test test/browser.e2e.js"
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "marked": "^18.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.0",
    "jsdom": "^31.0.0",
    "playwright-core": "^1.65.1"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nxproject/espanso-js.git"
  },
  "homepage": "https://github.com/nxproject/espanso-js#readme",
  "bugs": {
    "url": "https://github.com/nxproject/espanso-js/issues"
  },
  "keywords": [
    "espanso",
    "text-expander",
    "snippets",
    "browser",
    "autocomplete"
  ]
}
